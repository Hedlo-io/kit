export const DIRECTIONAL = new Set(["chevron-right", "logout", "megaphone", "arrow-right"]);

export function iconSvg(name: string | null | undefined): string {
  return ICONS[name ?? ""] ?? ICONS.dot!;
}

export function iconMarkup(name: string | null | undefined): RawHtml {
  return trustHtml(iconSvg(name));
}

component Icon(name: string, label?: string, ...attrs: Attrs) {
  view {
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" role={label ? "img" : undefined} aria-label={label} aria-hidden={label ? undefined : "true"} data-icon={name} class={cn("size-4 shrink-0", DIRECTIONAL.has(name) ? "rtl:-scale-x-100" : "", attrs.class)} {...attrs}>{iconMarkup(name)}</svg>
  }
}
