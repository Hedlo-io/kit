import { cn } from "../../lib/utils.ts";
import { buttonVariants } from "../ui/button.wx";
import { Icon } from "./icons.wx";
import { StatusPill } from "./status.wx";
import { relativeTime } from "./overlays.wx";

export interface JobRow {
  id: string;
  name: string;
  status: string;
  attempts: number;
  maxAttempts: number;
  runAt: number;
  updated: number;
  progress: number | null;
  error: string | null;
  canRetry: boolean;
  canCancel: boolean;
}

export interface ScheduleRow {
  name: string;
  cron: string;
  next: number | null;
  last: number | null;
  lastStatus: string | null;
}

export interface JobLabels {
  title: string;
  schedules: string;
  all: string;
  job: string;
  status: string;
  attempts: string;
  when: string;
  retry: string;
  cancel: string;
  empty: string;
  next: string;
  last: string;
  never: string;
}

export const DEFAULT_JOB_LABELS: JobLabels = {
  title: "Background jobs",
  schedules: "Schedules",
  all: "All",
  job: "Job",
  status: "Status",
  attempts: "Attempts",
  when: "When",
  retry: "Retry",
  cancel: "Cancel",
  empty: "No jobs match.",
  next: "Next run",
  last: "Last run",
  never: "never",
};

export const JOB_TONE: Record<string, string> = { queued: "pending", running: "running", dead: "failed", done: "healthy", cancelled: "cancelled" };

export function statusHref(url: URL, status: string | null): string {
  const u = new URL(url);
  if (status) u.searchParams.set("status", status);
  else u.searchParams.delete("status");
  return `${u.pathname}${u.search}`;
}

component JobQueueView(jobs: () => JobRow[], counts: () => Record<string, number>, url: URL, schedules?: () => ScheduleRow[], onRetry: (id: string) => Promise<unknown>, onCancel: (id: string) => Promise<unknown>, statusLabel?: (s: string) => string, now?: () => number, locale?: string, labels?: JobLabels, ...attrs: Attrs) {
  derived l = labels ?? DEFAULT_JOB_LABELS
  derived rows = jobs()
  derived totals = counts()
  derived current = url.searchParams.get("status")
  derived t = now ? now() : Date.now()
  derived plan = schedules ? schedules() : []
  derived label = (s: string) => (statusLabel ? statusLabel(s) : s)
  function retry(id: string) {
    return onRetry(id)
  }
  function cancel(id: string) {
    return onCancel(id)
  }
  view {
    <section aria-label={l.title} data-slot="job-queue" class={cn("flex flex-col gap-4", attrs.class)} {...attrs}>
      <nav aria-label={l.status} class="flex flex-wrap gap-1">
        <a href={statusHref(url, null)} aria-current={current === null ? "page" : undefined} class={cn(buttonVariants({ variant: current === null ? "secondary" : "ghost", size: "sm" }))}>{l.all}</a>
        {#each Object.keys(totals) as s (s)}
          <a href={statusHref(url, s)} aria-current={current === s ? "page" : undefined} class={cn(buttonVariants({ variant: current === s ? "secondary" : "ghost", size: "sm" }), "gap-2")}>
            {label(s)}
            <span class="bg-muted text-muted-foreground rounded-full px-1.5 text-xs tabular-nums">{String(totals[s] ?? 0)}</span>
          </a>
        {/each}
      </nav>
      {#if rows.length === 0}
        <p class="bg-card/60 text-muted-foreground rounded-2xl border border-dashed px-6 py-10 text-center text-sm leading-6">{l.empty}</p>
      {:else}
        <div class="bg-card overflow-x-auto rounded-2xl border">
          <table class="w-full text-sm">
            <thead class="bg-muted/40 text-muted-foreground text-xs">
              <tr>
                <th scope="col" class="px-4 py-2 text-start font-medium">{l.job}</th>
                <th scope="col" class="px-4 py-2 text-start font-medium">{l.status}</th>
                <th scope="col" class="px-4 py-2 text-end font-medium">{l.attempts}</th>
                <th scope="col" class="px-4 py-2 text-start font-medium">{l.when}</th>
                <th scope="col" class="px-4 py-2"><span class="sr-only">{l.retry}</span></th>
              </tr>
            </thead>
            <tbody class="divide-y">
              {#each rows as j (j.id)}
                <tr class="align-top">
                  <td class="px-4 py-2.5">
                    <div class="font-mono text-xs font-medium">{j.name}</div>
                    {#if j.error}
                      <p class="text-destructive mt-1 line-clamp-2 max-w-md text-xs break-all">{j.error}</p>
                    {/if}
                    {#if j.progress !== null && j.status === "running"}
                      <div class="bg-muted mt-1.5 h-1 w-40 overflow-hidden rounded-full" role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow={String(Math.round(j.progress * 100))} aria-label={j.name}>
                        <div class="bg-primary h-full" style={`width:${Math.round(j.progress * 100)}%`}></div>
                      </div>
                    {/if}
                  </td>
                  <td class="px-4 py-2.5"><StatusPill state={JOB_TONE[j.status] ?? j.status} label={label(j.status)} /></td>
                  <td class="px-4 py-2.5 text-end tabular-nums">{`${j.attempts}/${j.maxAttempts}`}</td>
                  <td class="text-muted-foreground px-4 py-2.5 text-xs">
                    <time datetime={new Date(j.status === "queued" ? j.runAt : j.updated).toISOString()}>{relativeTime(j.status === "queued" ? j.runAt : j.updated, t, locale ?? "en")}</time>
                  </td>
                  <td class="px-4 py-2.5">
                    <div class="flex justify-end gap-1">
                      {#if j.canRetry}
                        <button type="button" :busy @click={retry(j.id)} class={buttonVariants({ variant: "outline", size: "sm" })}><Icon name="refresh" />{l.retry}</button>
                      {/if}
                      {#if j.canCancel}
                        <button type="button" :busy @click={cancel(j.id)} class={buttonVariants({ variant: "ghost", size: "sm" })}><Icon name="x" />{l.cancel}</button>
                      {/if}
                    </div>
                  </td>
                </tr>
              {/each}
            </tbody>
          </table>
        </div>
      {/if}
      {#if plan.length > 0}
        <section aria-label={l.schedules} class="flex flex-col gap-2">
          <h3 class="text-sm font-medium">{l.schedules}</h3>
          <ul class="bg-card divide-y rounded-2xl border">
            {#each plan as s (s.name)}
              <li class="flex flex-wrap items-center gap-x-4 gap-y-1 px-4 py-2.5 text-sm">
                <Icon name="clock" class="text-muted-foreground" />
                <span class="font-mono text-xs font-medium">{s.name}</span>
                <code class="bg-muted rounded-md px-1.5 py-0.5 font-mono text-xs">{s.cron}</code>
                <span class="text-muted-foreground ms-auto text-xs">{l.next}: {s.next === null ? l.never : relativeTime(s.next, t, locale ?? "en")}</span>
                <span class="text-muted-foreground text-xs">{l.last}: {s.last === null ? l.never : relativeTime(s.last, t, locale ?? "en")}</span>
                {#if s.lastStatus}
                  <StatusPill state={JOB_TONE[s.lastStatus] ?? s.lastStatus} label={label(s.lastStatus)} />
                {/if}
              </li>
            {/each}
          </ul>
        </section>
      {/if}
    </section>
  }
}
