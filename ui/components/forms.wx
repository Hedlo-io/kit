import type { WeftEvent } from "@weft-framework/runtime";
import { cn } from "../../lib/utils.ts";
import { buttonVariants } from "../ui/button.wx";
import { inputClass } from "../ui/input.wx";
import { textareaClass } from "../ui/textarea.wx";
import { Icon } from "./icons.wx";
import { diffHunks, diffLines, languageOf, type DiffLine } from "./code.ts";
client import { tokenize } from "./code.ts";

client const TOKEN_CLASS: Record<string, string> = {
  comment: "text-muted-foreground italic",
  string: "text-chart-2",
  number: "text-chart-4",
  keyword: "text-chart-1 font-semibold",
  key: "text-chart-3",
  tag: "text-chart-1",
  attr: "text-chart-3",
  variable: "text-chart-5",
  punct: "text-muted-foreground",
}

export interface KeyValueRow {
  key: string;
  value: string;
  secret?: boolean;
  locked?: boolean;
  description?: string;
}

export interface KeyValueLabels {
  key: string;
  value: string;
  add: string;
  remove: string;
  reveal: string;
}

export const DEFAULT_KV_LABELS: KeyValueLabels = { key: "Key", value: "Value", add: "Add row", remove: "Remove row", reveal: "Show value" };

export const KEY_PATTERN = "[A-Za-z_][A-Za-z0-9_.\\-]{0,127}";

component KeyValueEditor(name: string, rows: KeyValueRow[], fixedKeys?: boolean, labels?: KeyValueLabels, ...attrs: Attrs) {
  derived l = labels ?? DEFAULT_KV_LABELS
  client function rowsEditor(el: HTMLElement) {
    const list = el.querySelector<HTMLElement>("[data-kv-list]")
    const tpl = el.querySelector<HTMLTemplateElement>("template")
    const onClick = (e: MouseEvent) => {
      const t = e.target as Element | null
      if (t?.closest("[data-kv-add]") && list && tpl) {
        const row = tpl.content.firstElementChild?.cloneNode(true) as HTMLElement | undefined
        if (row) {
          list.append(row)
          row.querySelector<HTMLInputElement>("input")?.focus()
        }
      }
      const rm = t?.closest("[data-kv-remove]")
      if (rm) {
        const row = rm.closest("[data-kv-row]")
        const next = (row?.nextElementSibling ?? row?.previousElementSibling)?.querySelector<HTMLInputElement>("input")
        row?.remove()
        next?.focus()
      }
      const eye = t?.closest("[data-kv-reveal]")
      if (eye) {
        const input = eye.closest("[data-kv-row]")?.querySelector<HTMLInputElement>("input[data-kv-value]")
        if (input) {
          const shown = input.type === "text"
          input.type = shown ? "password" : "text"
          eye.setAttribute("aria-pressed", shown ? "false" : "true")
        }
      }
    }
    el.addEventListener("click", onClick)
    return () => el.removeEventListener("click", onClick)
  }
  view {
    <div data-slot="key-value-editor" class={cn("flex flex-col gap-2", attrs.class)} use:rowsEditor {...attrs}>
      <div class="text-muted-foreground grid grid-cols-[1fr_1.5fr_auto] gap-2 px-1 text-xs font-medium">
        <span>{l.key}</span>
        <span>{l.value}</span>
        <span class="w-9"></span>
      </div>
      <div data-kv-list="" class="flex flex-col gap-2">
        {#each rows as r, i (r.key + ":" + i)}
          <div data-kv-row="" class="grid grid-cols-[1fr_1.5fr_auto] items-start gap-2">
            <div class="flex flex-col gap-1">
              <input name={name + ".key"} value={r.key} readonly={fixedKeys || r.locked} required pattern={KEY_PATTERN} aria-label={l.key} class={cn(inputClass, "font-mono text-xs")} />
              {#if r.description}
                <span class="text-muted-foreground px-1 text-xs">{r.description}</span>
              {/if}
            </div>
            <div class="relative">
              <input data-kv-value="" name={name + ".value"} value={r.value} type={r.secret ? "password" : "text"} readonly={r.locked} autocomplete="off" spellcheck="false" aria-label={`${l.value} ${r.key}`} class={cn(inputClass, "font-mono text-xs", r.secret ? "pe-9" : "")} />
              {#if r.secret}
                <button type="button" data-kv-reveal="" aria-pressed="false" aria-label={l.reveal} class="text-muted-foreground hover:text-foreground absolute top-1/2 end-2 -translate-y-1/2"><Icon name="eye" /></button>
              {/if}
            </div>
            {#if fixedKeys || r.locked}
              <span class="w-9"></span>
            {:else}
              <button type="button" data-kv-remove="" aria-label={l.remove} class={buttonVariants({ variant: "ghost", size: "icon" })}><Icon name="trash" /></button>
            {/if}
          </div>
        {/each}
      </div>
      {#if !fixedKeys}
        <template>
          <div data-kv-row="" class="grid grid-cols-[1fr_1.5fr_auto] items-start gap-2">
            <input name={name + ".key"} required pattern={KEY_PATTERN} aria-label={l.key} class={cn(inputClass, "font-mono text-xs")} />
            <input data-kv-value="" name={name + ".value"} autocomplete="off" spellcheck="false" aria-label={l.value} class={cn(inputClass, "font-mono text-xs")} />
            <button type="button" data-kv-remove="" aria-label={l.remove} class={buttonVariants({ variant: "ghost", size: "icon" })}><Icon name="trash" /></button>
          </div>
        </template>
        <button type="button" data-kv-add="" class={cn(buttonVariants({ variant: "outline", size: "sm" }), "self-start")}><Icon name="plus" />{l.add}</button>
      {/if}
    </div>
  }
}

export interface CronParts {
  minute: string;
  hour: string;
  dayOfMonth: string;
  month: string;
  dayOfWeek: string;
}

const CRON_RANGES: [keyof CronParts, number, number][] = [
  ["minute", 0, 59],
  ["hour", 0, 23],
  ["dayOfMonth", 1, 31],
  ["month", 1, 12],
  ["dayOfWeek", 0, 7],
];

export function cronField(src: string, min: number, max: number): Set<number> | null {
  const out = new Set<number>();
  const s = src.trim();
  if (s === "" || s.length > 64) return null;
  for (const part of s.split(",")) {
    const m = /^(\*|\d+(?:-\d+)?)(?:\/(\d+))?$/.exec(part);
    if (!m) return null;
    const step = m[2] === undefined ? 1 : Number(m[2]);
    if (!Number.isInteger(step) || step < 1 || step > max) return null;
    let lo = min;
    let hi = max;
    if (m[1] !== "*") {
      const [a, b] = m[1]!.split("-").map(Number);
      lo = a!;
      hi = b === undefined ? (m[2] === undefined ? a! : max) : b;
    }
    if (lo < min || hi > max || lo > hi) return null;
    for (let v = lo; v <= hi; v += step) out.add(v);
  }
  return out;
}

export function cronValid(p: CronParts): (keyof CronParts)[] {
  return CRON_RANGES.filter(([k, lo, hi]) => cronField(p[k], lo, hi) === null).map(([k]) => k);
}

export function cronNext(p: CronParts, from: number, count = 3): number[] {
  const sets = CRON_RANGES.map(([k, lo, hi]) => cronField(p[k], lo, hi));
  if (sets.some((s) => s === null)) return [];
  const [mi, ho, dm, mo, dw] = sets as Set<number>[];
  if (dw!.has(7)) dw!.add(0);
  const domAny = p.dayOfMonth.trim() === "*";
  const dowAny = p.dayOfWeek.trim() === "*";
  const out: number[] = [];
  const d = new Date(from);
  d.setSeconds(0, 0);
  d.setMinutes(d.getMinutes() + 1);
  const limit = from + 366 * 86400000 * 2;
  while (out.length < count && d.getTime() < limit) {
    if (!mo!.has(d.getMonth() + 1)) {
      d.setMonth(d.getMonth() + 1, 1);
      d.setHours(0, 0, 0, 0);
      continue;
    }
    const domOk = dm!.has(d.getDate());
    const dowOk = dw!.has(d.getDay());
    const dayOk = domAny && dowAny ? true : domAny ? dowOk : dowAny ? domOk : domOk || dowOk;
    if (!dayOk) {
      d.setDate(d.getDate() + 1);
      d.setHours(0, 0, 0, 0);
      continue;
    }
    if (!ho!.has(d.getHours())) {
      d.setHours(d.getHours() + 1, 0, 0, 0);
      continue;
    }
    if (!mi!.has(d.getMinutes())) {
      d.setMinutes(d.getMinutes() + 1, 0, 0);
      continue;
    }
    out.push(d.getTime());
    d.setMinutes(d.getMinutes() + 1, 0, 0);
  }
  return out;
}

export interface CronPreset {
  id: string;
  label: string;
  parts: CronParts;
}

export const CRON_PRESETS: CronPreset[] = [
  { id: "hourly", label: "Every hour", parts: { minute: "0", hour: "*", dayOfMonth: "*", month: "*", dayOfWeek: "*" } },
  { id: "daily", label: "Every day at 04:00", parts: { minute: "0", hour: "4", dayOfMonth: "*", month: "*", dayOfWeek: "*" } },
  { id: "weekly", label: "Every Monday at 04:00", parts: { minute: "0", hour: "4", dayOfMonth: "*", month: "*", dayOfWeek: "1" } },
  { id: "every15", label: "Every 15 minutes", parts: { minute: "*/15", hour: "*", dayOfMonth: "*", month: "*", dayOfWeek: "*" } },
];

export interface CronLabels {
  minute: string;
  hour: string;
  dayOfMonth: string;
  month: string;
  dayOfWeek: string;
  presets: string;
  next: string;
  invalid: string;
}

export const DEFAULT_CRON_LABELS: CronLabels = { minute: "Minute", hour: "Hour", dayOfMonth: "Day of month", month: "Month", dayOfWeek: "Day of week", presets: "Presets", next: "Next runs", invalid: "Invalid expression" };

component CronEditor(value: CronParts, presets?: CronPreset[], labels?: CronLabels, locale?: string, timeZone?: string, now?: () => number, ...attrs: Attrs) {
  derived l = labels ?? DEFAULT_CRON_LABELS
  signal parts = value
  derived bad = cronValid(parts)
  derived runs = bad.length ? [] : cronNext(parts, now ? now() : Date.now(), 3)
  derived fmt = new Intl.DateTimeFormat(locale ?? "en", { dateStyle: "medium", timeStyle: "short", timeZone })
  function set(field: keyof CronParts, e: WeftEvent) {
    parts = { ...parts, [field]: String(e.value ?? "").slice(0, 64) }
  }
  function pick(id: string) {
    const p = (presets ?? CRON_PRESETS).find((x) => x.id === id)
    if (p) parts = { ...p.parts }
  }
  view {
    <fieldset data-slot="cron-editor" class={cn("flex flex-col gap-3", attrs.class)} {...attrs}>
      <div class="flex flex-wrap gap-1.5" role="group" aria-label={l.presets}>
        {#each presets ?? CRON_PRESETS as p (p.id)}
          <button type="button" class={buttonVariants({ variant: "outline", size: "sm" })} @click={pick(p.id)}>{p.label}</button>
        {/each}
      </div>
      <div class="grid grid-cols-2 gap-2 sm:grid-cols-5">
        <label class="flex flex-col gap-1 text-xs">
          <span class="text-muted-foreground">{l.minute}</span>
          <input name="minute" value={parts.minute} aria-invalid={bad.includes("minute") ? "true" : undefined} class={cn(inputClass, "font-mono")} @input.debounce(250ms)={set("minute")} />
        </label>
        <label class="flex flex-col gap-1 text-xs">
          <span class="text-muted-foreground">{l.hour}</span>
          <input name="hour" value={parts.hour} aria-invalid={bad.includes("hour") ? "true" : undefined} class={cn(inputClass, "font-mono")} @input.debounce(250ms)={set("hour")} />
        </label>
        <label class="flex flex-col gap-1 text-xs">
          <span class="text-muted-foreground">{l.dayOfMonth}</span>
          <input name="dayOfMonth" value={parts.dayOfMonth} aria-invalid={bad.includes("dayOfMonth") ? "true" : undefined} class={cn(inputClass, "font-mono")} @input.debounce(250ms)={set("dayOfMonth")} />
        </label>
        <label class="flex flex-col gap-1 text-xs">
          <span class="text-muted-foreground">{l.month}</span>
          <input name="month" value={parts.month} aria-invalid={bad.includes("month") ? "true" : undefined} class={cn(inputClass, "font-mono")} @input.debounce(250ms)={set("month")} />
        </label>
        <label class="flex flex-col gap-1 text-xs">
          <span class="text-muted-foreground">{l.dayOfWeek}</span>
          <input name="dayOfWeek" value={parts.dayOfWeek} aria-invalid={bad.includes("dayOfWeek") ? "true" : undefined} class={cn(inputClass, "font-mono")} @input.debounce(250ms)={set("dayOfWeek")} />
        </label>
      </div>
      <div class="bg-muted/40 rounded-lg px-3 py-2 text-xs" aria-live="polite">
        {#if bad.length}
          <span role="alert" class="text-destructive">{l.invalid}</span>
        {:else}
          <span class="text-muted-foreground">{l.next}:</span>
          {#each runs as t (t)}
            <time datetime={new Date(t).toISOString()} class="bg-background ms-2 inline-block rounded border px-1.5 py-0.5 font-mono">{fmt.format(t)}</time>
          {/each}
        {/if}
      </div>
    </fieldset>
  }
}

export interface CodeLabels {
  editor: string;
  lines: string;
}

component CodeEditor(name: string, value: string, label: string, language?: string, path?: string, readonly?: boolean, rows?: number, ...attrs: Attrs) {
  derived lineCount = Math.max(value.split("\n").length, rows ?? 20)
  derived lang = language ?? (path ? languageOf(path) : "text")
  client function code(el: HTMLElement) {
    const area = el.querySelector<HTMLTextAreaElement>("textarea")
    const gutter = el.querySelector<HTMLElement>("[data-gutter]")
    const layer = el.querySelector<HTMLElement>("[data-highlight]")
    if (!area || !gutter) return
    const kind = el.dataset.language ?? "text"
    let frame = 0
    const paint = () => {
      frame = 0
      if (!layer) return
      const out = document.createDocumentFragment()
      for (const tok of tokenize(area.value + "\n", kind)) {
        const cls = TOKEN_CLASS[tok.kind]
        if (!cls) {
          out.append(tok.text)
          continue
        }
        const span = document.createElement("span")
        span.className = cls
        span.textContent = tok.text
        out.append(span)
      }
      layer.replaceChildren(out)
      layer.scrollTop = area.scrollTop
      layer.scrollLeft = area.scrollLeft
    }
    const schedule = () => {
      if (!frame) frame = requestAnimationFrame(paint)
    }
    if (layer && kind !== "text") {
      el.dataset.highlight = "on"
      paint()
    }
    const numbers = () => {
      const n = Math.max(area.value.split("\n").length, Number(area.rows) || 1)
      if (gutter.dataset.lines !== String(n)) {
        gutter.dataset.lines = String(n)
        gutter.textContent = Array.from({ length: n }, (_, i) => String(i + 1)).join("\n")
      }
      gutter.scrollTop = area.scrollTop
      if (layer) {
        layer.scrollTop = area.scrollTop
        layer.scrollLeft = area.scrollLeft
      }
    }
    const edited = () => {
      if (el.dataset.highlight === "on") schedule()
    }
    const key = (e: KeyboardEvent) => {
      if (area.readOnly) return
      if (e.key === "Tab" && !e.ctrlKey && !e.metaKey && !e.altKey) {
        const s = area.selectionStart
        const end = area.selectionEnd
        if (e.shiftKey) {
          const start = area.value.lastIndexOf("\n", s - 1) + 1
          if (area.value.slice(start, start + 2) === "  ") {
            e.preventDefault()
            area.setRangeText("", start, start + 2, "preserve")
            area.dispatchEvent(new Event("input", { bubbles: true }))
          }
          return
        }
        if (s === end) {
          e.preventDefault()
          area.setRangeText("  ", s, end, "end")
          area.dispatchEvent(new Event("input", { bubbles: true }))
        }
      } else if (e.key === "Escape") {
        area.blur()
      } else if ((e.ctrlKey || e.metaKey) && e.key.toLowerCase() === "s") {
        e.preventDefault()
        area.form?.requestSubmit()
      }
    }
    area.addEventListener("input", numbers)
    area.addEventListener("input", edited)
    area.addEventListener("scroll", numbers)
    area.addEventListener("keydown", key)
    numbers()
    return () => {
      if (frame) cancelAnimationFrame(frame)
      area.removeEventListener("input", numbers)
      area.removeEventListener("input", edited)
      area.removeEventListener("scroll", numbers)
      area.removeEventListener("keydown", key)
    }
  }
  view {
    <div data-slot="code-editor" data-language={lang} class={cn("group/code bg-muted/30 focus-within:ring-ring/50 focus-within:border-ring flex overflow-hidden rounded-xl border font-mono text-xs leading-5 focus-within:ring-[3px]", attrs.class)} use:code {...attrs}>
      <pre data-gutter="" aria-hidden="true" class="text-muted-foreground bg-muted/50 m-0 overflow-hidden border-e px-3 py-2 text-end select-none">{Array.from({ length: lineCount }, (_, i) => String(i + 1)).join("\n")}</pre>
      <div class="relative flex min-w-0 flex-1">
        <pre data-highlight="" aria-hidden="true" class="pointer-events-none absolute inset-0 m-0 hidden overflow-hidden px-3 py-2 font-mono text-xs leading-5 whitespace-pre group-data-[highlight=on]/code:block"></pre>
        <textarea name={name} aria-label={label} readonly={readonly} rows={String(rows ?? 20)} spellcheck="false" autocapitalize="off" autocomplete="off" wrap="off" class={cn(textareaClass, "relative min-h-0 flex-1 resize-y rounded-none border-0 bg-transparent px-3 py-2 font-mono text-xs leading-5 whitespace-pre shadow-none focus-visible:ring-0 group-data-[highlight=on]/code:caret-foreground group-data-[highlight=on]/code:text-transparent selection:bg-primary/25")}>{value}</textarea>
      </div>
    </div>
  }
}

component CodeDiff(before: string, after: string, labels: { title: string; added: string; removed: string; unchanged: string; tooLarge: string; skipped: string }, context?: number, ...attrs: Attrs) {
  derived lines = diffLines(before, after)
  derived hunks = lines ? diffHunks(lines, context ?? 3) : []
  derived added = lines ? lines.filter((l: DiffLine) => l.op === "add").length : 0
  derived removed = lines ? lines.filter((l: DiffLine) => l.op === "del").length : 0
  view {
    <figure data-slot="code-diff" class={cn("bg-muted/30 overflow-hidden rounded-xl border font-mono text-xs leading-5", attrs.class)} {...attrs}>
      <figcaption class="bg-muted/50 flex flex-wrap items-center gap-3 border-b px-3 py-2 font-sans text-sm">
        <span class="font-medium">{labels.title}</span>
        <span class="text-chart-2 tabular-nums">+{added} {labels.added}</span>
        <span class="text-destructive tabular-nums">−{removed} {labels.removed}</span>
      </figcaption>
      {#if !lines}
        <p role="status" class="text-muted-foreground px-3 py-4 font-sans text-sm">{labels.tooLarge}</p>
      {:else if hunks.length === 0}
        <p role="status" class="text-muted-foreground px-3 py-4 font-sans text-sm">{labels.unchanged}</p>
      {:else}
        <div class="overflow-x-auto">
          <table class="w-full border-collapse">
            {#each hunks as h, hi (hi)}
              <tbody>
                {#if h.skippedBefore > 0}
                  <tr>
                    <td colspan="4" class="bg-muted/40 text-muted-foreground px-3 py-1 font-sans">{labels.skipped.replace("{n}", String(h.skippedBefore))}</td>
                  </tr>
                {/if}
                {#each h.lines as l, li (hi + ":" + li)}
                  <tr class={l.op === "add" ? "bg-chart-2/10" : l.op === "del" ? "bg-destructive/10" : ""}>
                    <td class="text-muted-foreground w-px border-e px-2 text-end tabular-nums select-none">{l.a ?? ""}</td>
                    <td class="text-muted-foreground w-px border-e px-2 text-end tabular-nums select-none">{l.b ?? ""}</td>
                    <td class={"w-px px-2 select-none " + (l.op === "add" ? "text-chart-2" : l.op === "del" ? "text-destructive" : "text-muted-foreground")}>
                      <span aria-hidden="true">{l.op === "add" ? "+" : l.op === "del" ? "−" : " "}</span>
                      <span class="sr-only">{l.op === "add" ? labels.added : l.op === "del" ? labels.removed : ""}</span>
                    </td>
                    <td class="px-2 whitespace-pre">{l.text}</td>
                  </tr>
                {/each}
              </tbody>
            {/each}
          </table>
        </div>
      {/if}
    </figure>
  }
}
