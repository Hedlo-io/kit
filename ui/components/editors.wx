import type { WeftEvent } from "@weft-framework/runtime";
import { cn } from "../../lib/utils.ts";
import { buttonVariants } from "../ui/button.wx";
import { inputClass } from "../ui/input.wx";
import { textareaClass } from "../ui/textarea.wx";
import { ICONS, Icon } from "./icons.wx";
import { CodeEditor } from "./forms.wx";

export type ThemeMode = "light" | "dark" | "system";

export interface ThemeDraft {
  productName: string;
  logo: string;
  logoDark: string;
  favicon: string;
  loginBackground: string;
  mode: ThemeMode;
  light: Record<string, string>;
  dark: Record<string, string>;
  shared: Record<string, string>;
  customCss: string;
}

export interface PresetChoice {
  id: string;
  title: string;
  swatch?: string[];
}

export interface ThemeLabels {
  title: string;
  identity: string;
  productName: string;
  logo: string;
  logoDark: string;
  favicon: string;
  loginBackground: string;
  mode: string;
  modes: Record<ThemeMode, string>;
  presets: string;
  colors: string;
  light: string;
  dark: string;
  radius: string;
  customCss: string;
  preview: string;
  save: string;
  reset: string;
  saved: string;
  export: string;
  importLabel: string;
  sampleButton: string;
  sampleCard: string;
  sampleText: string;
  layout: string;
  fontSans: string;
  fontHeading: string;
  fonts: Record<FontChoice, string>;
  density: string;
  densities: Record<"compact" | "default" | "comfortable", string>;
  width: string;
  widths: Record<"narrow" | "standard" | "wide" | "full", string>;
  shadow: string;
  shadows: Record<"none" | "soft" | "strong", string>;
  sitePreview: string;
  sitePreviewLead: string;
  siteOpen: string;
  inherit: string;
}

export const DEFAULT_THEME_LABELS: ThemeLabels = {
  title: "Branding",
  identity: "Identity",
  productName: "Product name",
  logo: "Logo URL",
  logoDark: "Dark logo URL",
  favicon: "Favicon URL",
  loginBackground: "Sign-in background URL",
  mode: "Default mode",
  modes: { light: "Light", dark: "Dark", system: "Follow system" },
  presets: "Presets",
  colors: "Colours",
  light: "Light",
  dark: "Dark",
  radius: "Corner radius",
  customCss: "Custom CSS",
  preview: "Preview",
  save: "Save",
  reset: "Reset to inherited",
  saved: "Saved",
  export: "Export",
  importLabel: "Import JSON",
  sampleButton: "Primary action",
  sampleCard: "Server status",
  sampleText: "This is how text and cards will look.",
  layout: "Type and layout",
  fontSans: "Body font",
  fontHeading: "Headings",
  fonts: { system: "System", humanist: "Humanist", geometric: "Geometric", serif: "Serif", mono: "Monospace" },
  density: "Density",
  densities: { compact: "Compact", default: "Default", comfortable: "Comfortable" },
  width: "Page width",
  widths: { narrow: "Narrow", standard: "Standard", wide: "Wide", full: "Full width" },
  shadow: "Shadows",
  shadows: { none: "None", soft: "Soft", strong: "Strong" },
  sitePreview: "Live on the site",
  sitePreviewLead: "Pick a page to open it with your unsaved draft. The link works for ten minutes.",
  siteOpen: "Open preview",
  inherit: "Inherited",
};

export type FontChoice = "system" | "humanist" | "geometric" | "serif" | "mono";

export const FONT_STACKS: Record<FontChoice, string> = {
  system: "ui-sans-serif, system-ui, sans-serif",
  humanist: "Seravek, \"Gill Sans Nova\", Ubuntu, Calibri, \"DejaVu Sans\", sans-serif",
  geometric: "Avenir, Montserrat, Corbel, \"URW Gothic\", sans-serif",
  serif: "\"Iowan Old Style\", \"Palatino Linotype\", \"URW Palladio L\", P052, serif",
  mono: "ui-monospace, \"Cascadia Code\", Menlo, Consolas, monospace",
};

export const DENSITY_VALUES = { compact: "0.225rem", default: "", comfortable: "0.275rem" } as const;
export const WIDTH_VALUES = { narrow: "64rem", standard: "", wide: "96rem", full: "100%" } as const;
export const SHADOW_VALUES = {
  none: { "shadow-sm": "none", "shadow-md": "none", "shadow-lg": "none" },
  soft: { "shadow-sm": "", "shadow-md": "", "shadow-lg": "" },
  strong: { "shadow-sm": "0 1px 3px rgb(0 0 0 / 0.18)", "shadow-md": "0 6px 16px -4px rgb(0 0 0 / 0.25)", "shadow-lg": "0 18px 40px -12px rgb(0 0 0 / 0.35)" },
} as const;

export interface SitePage {
  label: string;
  path: string;
}

export function fontOf(v: string | undefined): FontChoice | "" {
  for (const [k, stack] of Object.entries(FONT_STACKS)) if (stack === v) return k as FontChoice;
  return ""
}

export function choiceOf<T extends Record<string, string>>(table: T, v: string | undefined): keyof T | "" {
  for (const [k, value] of Object.entries(table)) if (value !== "" && value === v) return k;
  return v ? "" : ((Object.entries(table).find(([, value]) => value === "")?.[0] ?? "") as keyof T)
}

export const PREVIEW_TOKENS = ["background", "foreground", "card", "card-foreground", "primary", "primary-foreground", "secondary", "secondary-foreground", "muted", "muted-foreground", "accent", "accent-foreground", "destructive", "border", "input", "ring", "chart-1", "chart-2", "chart-3", "chart-4", "chart-5"];

export const COLOR_VALUE = /^[#a-zA-Z0-9.,%()\s/+-]{1,80}$/;

export function swatchStyle(v: string | undefined): string {
  return v && COLOR_VALUE.test(v) ? `background:${v}` : "background:transparent";
}

export function previewStyle(draft: ThemeDraft, side: "light" | "dark", base: Record<string, string>): string {
  const vars: string[] = [];
  const pick = { ...base, ...draft.shared, ...draft[side] };
  for (const [k, v] of Object.entries(pick)) {
    if (!/^[a-z0-9-]{1,40}$/.test(k)) continue;
    if (!COLOR_VALUE.test(v)) continue;
    vars.push(`--${k}:${v}`);
  }
  return vars.join(";");
}

component ThemePreview(draft: ThemeDraft, side: "light" | "dark", base: Record<string, string>, labels: ThemeLabels) {
  view {
    <div
      data-slot="theme-preview"
      data-side={side}
      style={previewStyle(draft, side, base)}
      class="bg-card text-foreground flex flex-col gap-3 rounded-2xl border p-4"
    >
      <div class="flex items-center gap-2">
        {#if (side === "dark" && draft.logoDark) || draft.logo}
          <img
            src={side === "dark" && draft.logoDark ? draft.logoDark : draft.logo}
            alt=""
            class="size-6 rounded object-contain"
          />
        {:else}
          <span class="bg-primary text-primary-foreground flex size-6 items-center justify-center rounded text-xs font-semibold">{(draft.productName || "?").slice(0, 1).toUpperCase()}</span>
        {/if}
        <span class="text-sm font-semibold">{draft.productName || "—"}</span>
      </div>
      <div class="bg-card text-card-foreground flex flex-col gap-2 rounded-xl border p-3">
        <span class="text-sm font-medium">{labels.sampleCard}</span>
        <span class="text-muted-foreground text-xs">{labels.sampleText}</span>
        <div class="bg-muted h-1.5 overflow-hidden rounded-full"><div class="bg-primary h-full w-2/3"></div></div>
      </div>
      <div class="flex flex-wrap gap-2">
        <span class="bg-primary text-primary-foreground rounded-md px-3 py-1.5 text-xs font-medium">{labels.sampleButton}</span>
        <span class="bg-secondary text-secondary-foreground rounded-md px-3 py-1.5 text-xs font-medium">{labels.light}</span>
        <span class="border-input rounded-md border px-3 py-1.5 text-xs">{labels.dark}</span>
        <span class="bg-destructive rounded-md px-3 py-1.5 text-xs font-medium text-destructive-foreground">!</span>
      </div>
      <div class="flex gap-1">
        <span class="bg-chart-1 size-4 rounded-full"></span>
        <span class="bg-chart-2 size-4 rounded-full"></span>
        <span class="bg-chart-3 size-4 rounded-full"></span>
        <span class="bg-chart-4 size-4 rounded-full"></span>
        <span class="bg-chart-5 size-4 rounded-full"></span>
      </div>
    </div>
  }
}

component ThemeEditor(value: ThemeDraft, base: { light: Record<string, string>; dark: Record<string, string> }, tokens: string[], presets: PresetChoice[], canEditCode: boolean, onSave: (draft: ThemeDraft) => Promise<string | null> | string | null, onPreset: (id: string) => Promise<ThemeDraft | null> | ThemeDraft | null, onReset: () => Promise<ThemeDraft> | ThemeDraft, exportHref?: string, labels?: ThemeLabels, site?: { pages: SitePage[]; url: (draft: ThemeDraft, path: string) => Promise<string> | string }, ...attrs: Attrs) {
  derived l = labels ?? DEFAULT_THEME_LABELS
  signal draft = value
  signal error = ""
  signal saved = false
  function setField(field: "productName" | "logo" | "logoDark" | "favicon" | "loginBackground" | "customCss", e: WeftEvent) {
    draft = { ...draft, [field]: String(e.value ?? "").slice(0, field === "customCss" ? 65536 : 2048) }
    saved = false
  }
  function setMode(e: WeftEvent) {
    const v = String(e.value ?? "")
    if (v === "light" || v === "dark" || v === "system") draft = { ...draft, mode: v }
    saved = false
  }
  function setToken(side: "light" | "dark" | "shared", token: string, e: WeftEvent) {
    const v = String(e.value ?? "").trim().slice(0, 80)
    const next = { ...draft[side] }
    if (v === "") delete next[token]
    else next[token] = v
    draft = { ...draft, [side]: next }
    saved = false
  }
  signal sitePath = site?.pages[0]?.path ?? ""
  signal siteSrc = ""
  signal siteError = ""
  derived shadowChoice = draft.shared["shadow-sm"] === "none" ? "none" : draft.shared["shadow-sm"] === SHADOW_VALUES.strong["shadow-sm"] ? "strong" : "soft"
  function setShared(patch: Record<string, string>) {
    const next = { ...draft.shared }
    for (const [k, v] of Object.entries(patch)) {
      if (v === "") delete next[k]
      else next[k] = v
    }
    draft = { ...draft, shared: next }
    saved = false
  }
  function pickFont(token: "font-sans" | "font-heading", e: WeftEvent) {
    const v = String(e.value ?? "") as FontChoice
    setShared({ [token]: FONT_STACKS[v] ?? "" })
  }
  function pickDensity(e: WeftEvent) {
    setShared({ spacing: DENSITY_VALUES[String(e.value ?? "") as keyof typeof DENSITY_VALUES] ?? "" })
  }
  function pickWidth(e: WeftEvent) {
    setShared({ container: WIDTH_VALUES[String(e.value ?? "") as keyof typeof WIDTH_VALUES] ?? "" })
  }
  function pickShadow(e: WeftEvent) {
    setShared({ ...(SHADOW_VALUES[String(e.value ?? "") as keyof typeof SHADOW_VALUES] ?? SHADOW_VALUES.soft) })
  }
  function showSite(path: string) {
    if (!site) return
    sitePath = path
    siteError = ""
    return Promise.resolve(site.url(draft, path)).then(
      (u) => {
        siteSrc = u
      },
      (e) => {
        siteError = e instanceof Error ? e.message : String(e)
      },
    )
  }
  function preset(id: string) {
    return Promise.resolve(onPreset(id)).then((d) => {
      if (d) {
        draft = d
        saved = false
      }
    })
  }
  function reset() {
    return Promise.resolve(onReset()).then((d) => {
      draft = d
      saved = true
      error = ""
    })
  }
  function save() {
    return Promise.resolve(onSave(draft)).then((err) => {
      error = err ?? ""
      saved = err === null
    })
  }
  view {
    <div data-slot="theme-editor" class={cn("grid gap-6 lg:grid-cols-[minmax(0,1fr)_22rem]", attrs.class)} {...attrs}>
      <form class="flex flex-col gap-6" @submit.prevent={save}>
        <fieldset class="bg-card flex flex-col gap-4 rounded-2xl border p-5">
          <legend class="sr-only">{l.identity}</legend>
          <h3 class="text-sm font-semibold">{l.identity}</h3>
          <div class="grid gap-4 sm:grid-cols-2">
            <label class="flex flex-col gap-1 text-sm">
              <span class="font-medium">{l.productName}</span>
              <input value={draft.productName} maxlength="60" class={inputClass} @input.debounce(300ms)={setField("productName")} />
            </label>
            <label class="flex flex-col gap-1 text-sm">
              <span class="font-medium">{l.mode}</span>
              <select class={inputClass} @change={setMode}>
                <option value="system" selected={draft.mode === "system"}>{l.modes.system}</option>
                <option value="light" selected={draft.mode === "light"}>{l.modes.light}</option>
                <option value="dark" selected={draft.mode === "dark"}>{l.modes.dark}</option>
              </select>
            </label>
            <label class="flex flex-col gap-1 text-sm">
              <span class="font-medium">{l.logo}</span>
              <input type="url" value={draft.logo} class={inputClass} @input.debounce(400ms)={setField("logo")} />
            </label>
            <label class="flex flex-col gap-1 text-sm">
              <span class="font-medium">{l.logoDark}</span>
              <input type="url" value={draft.logoDark} class={inputClass} @input.debounce(400ms)={setField("logoDark")} />
            </label>
            <label class="flex flex-col gap-1 text-sm">
              <span class="font-medium">{l.favicon}</span>
              <input type="url" value={draft.favicon} class={inputClass} @input.debounce(400ms)={setField("favicon")} />
            </label>
            <label class="flex flex-col gap-1 text-sm">
              <span class="font-medium">{l.loginBackground}</span>
              <input type="url" value={draft.loginBackground} class={inputClass} @input.debounce(400ms)={setField("loginBackground")} />
            </label>
          </div>
        </fieldset>
        {#if presets.length}
          <fieldset class="bg-card flex flex-col gap-3 rounded-2xl border p-5">
            <legend class="sr-only">{l.presets}</legend>
            <h3 class="text-sm font-semibold">{l.presets}</h3>
            <div class="grid grid-cols-2 gap-2 sm:grid-cols-4">
              {#each presets as p (p.id)}
                <button type="button" class="hover:border-primary flex flex-col items-start gap-2 rounded-lg border p-3 text-start text-sm transition-colors" @click={preset(p.id)} :busy>
                  <span class="flex gap-1">
                    {#each (p.swatch ?? []).slice(0, 5) as c, i (i)}
                      <span class="size-4 rounded-full border" style={swatchStyle(c)}></span>
                    {/each}
                  </span>
                  {p.title}
                </button>
              {/each}
            </div>
          </fieldset>
        {/if}
        <fieldset class="bg-card flex flex-col gap-3 rounded-2xl border p-5">
          <legend class="sr-only">{l.colors}</legend>
          <h3 class="text-sm font-semibold">{l.colors}</h3>
          <div class="text-muted-foreground grid grid-cols-[minmax(8rem,1fr)_1fr_1fr] gap-2 text-xs font-medium">
            <span></span>
            <span>{l.light}</span>
            <span>{l.dark}</span>
          </div>
          {#each tokens as tk (tk)}
            <div class="grid grid-cols-[minmax(8rem,1fr)_1fr_1fr] items-center gap-2">
              <code class="truncate font-mono text-xs">{tk}</code>
              <div class="flex items-center gap-1.5">
                <span class="size-5 shrink-0 rounded border" style={swatchStyle(draft.light[tk] ?? base.light[tk])} aria-hidden="true"></span>
                <input value={draft.light[tk] ?? ""} placeholder={base.light[tk] ?? ""} aria-label={`${tk} · ${l.light}`} class={cn(inputClass, "h-8 font-mono text-xs")} @input.debounce(400ms)={setToken("light", tk)} />
              </div>
              <div class="flex items-center gap-1.5">
                <span class="size-5 shrink-0 rounded border" style={swatchStyle(draft.dark[tk] ?? base.dark[tk])} aria-hidden="true"></span>
                <input value={draft.dark[tk] ?? ""} placeholder={base.dark[tk] ?? ""} aria-label={`${tk} · ${l.dark}`} class={cn(inputClass, "h-8 font-mono text-xs")} @input.debounce(400ms)={setToken("dark", tk)} />
              </div>
            </div>
          {/each}
          <label class="flex items-center gap-2 text-sm">
            <span class="min-w-32 font-medium">{l.radius}</span>
            <input value={draft.shared.radius ?? ""} placeholder="0.625rem" class={cn(inputClass, "h-8 w-32 font-mono text-xs")} @input.debounce(400ms)={setToken("shared", "radius")} />
          </label>
        </fieldset>
        <fieldset class="bg-card flex flex-col gap-4 rounded-2xl border p-5">
          <legend class="sr-only">{l.layout}</legend>
          <h3 class="text-sm font-semibold">{l.layout}</h3>
          <div class="grid gap-4 sm:grid-cols-2">
            <label class="flex flex-col gap-1.5 text-sm">
              <span class="font-medium">{l.fontSans}</span>
              <select class={cn(inputClass, "h-9")} @change={pickFont("font-sans")}>
                <option value="" selected={fontOf(draft.shared["font-sans"]) === ""}>{l.inherit}</option>
                {#each Object.keys(FONT_STACKS) as f (f)}
                  <option value={f} selected={fontOf(draft.shared["font-sans"]) === f} style={"font-family:" + FONT_STACKS[f as FontChoice]}>{l.fonts[f as FontChoice]}</option>
                {/each}
              </select>
            </label>
            <label class="flex flex-col gap-1.5 text-sm">
              <span class="font-medium">{l.fontHeading}</span>
              <select class={cn(inputClass, "h-9")} @change={pickFont("font-heading")}>
                <option value="" selected={fontOf(draft.shared["font-heading"]) === ""}>{l.inherit}</option>
                {#each Object.keys(FONT_STACKS) as f (f)}
                  <option value={f} selected={fontOf(draft.shared["font-heading"]) === f}>{l.fonts[f as FontChoice]}</option>
                {/each}
              </select>
            </label>
          </div>
          <div class="flex flex-col gap-1.5 text-sm" role="radiogroup" aria-label={l.density}>
            <span class="font-medium">{l.density}</span>
            <div class="bg-muted inline-flex w-fit rounded-lg p-0.5">
              {#each Object.keys(DENSITY_VALUES) as d (d)}
                <label class={"cursor-pointer rounded-md px-3 py-1.5 text-xs transition-colors " + (choiceOf(DENSITY_VALUES, draft.shared.spacing) === d ? "bg-primary text-primary-foreground" : "hover:bg-muted")}>
                  <input type="radio" name="density" value={d} checked={choiceOf(DENSITY_VALUES, draft.shared.spacing) === d} class="sr-only" @change={pickDensity} />
                  {l.densities[d as keyof typeof DENSITY_VALUES]}
                </label>
              {/each}
            </div>
          </div>
          <div class="flex flex-col gap-1.5 text-sm" role="radiogroup" aria-label={l.width}>
            <span class="font-medium">{l.width}</span>
            <div class="bg-muted inline-flex w-fit flex-wrap rounded-lg p-0.5">
              {#each Object.keys(WIDTH_VALUES) as wv (wv)}
                <label class={"cursor-pointer rounded-md px-3 py-1.5 text-xs transition-colors " + (choiceOf(WIDTH_VALUES, draft.shared.container) === wv ? "bg-primary text-primary-foreground" : "hover:bg-muted")}>
                  <input type="radio" name="width" value={wv} checked={choiceOf(WIDTH_VALUES, draft.shared.container) === wv} class="sr-only" @change={pickWidth} />
                  {l.widths[wv as keyof typeof WIDTH_VALUES]}
                </label>
              {/each}
            </div>
          </div>
          <div class="flex flex-col gap-1.5 text-sm" role="radiogroup" aria-label={l.shadow}>
            <span class="font-medium">{l.shadow}</span>
            <div class="bg-muted inline-flex w-fit rounded-lg p-0.5">
              {#each Object.keys(SHADOW_VALUES) as sv (sv)}
                <label class={"cursor-pointer rounded-md px-3 py-1.5 text-xs transition-colors " + (shadowChoice === sv ? "bg-primary text-primary-foreground" : "hover:bg-muted")}>
                  <input type="radio" name="shadow" value={sv} checked={shadowChoice === sv} class="sr-only" @change={pickShadow} />
                  {l.shadows[sv as keyof typeof SHADOW_VALUES]}
                </label>
              {/each}
            </div>
          </div>
        </fieldset>
        {#if canEditCode}
          <fieldset class="bg-card flex flex-col gap-3 rounded-2xl border p-5">
            <legend class="sr-only">{l.customCss}</legend>
            <h3 class="text-sm font-semibold">{l.customCss}</h3>
            <CodeEditor name="customCss" value={draft.customCss} label={l.customCss} language="css" rows={10} @input.debounce(600ms)={setField("customCss")} />
          </fieldset>
        {/if}
        <div class="bg-card sticky bottom-0 flex flex-wrap items-center gap-2 border-t py-3">
          <button type="submit" class={buttonVariants({})} :busy>{l.save}</button>
          <button type="button" class={buttonVariants({ variant: "outline" })} @click={reset} :busy>{l.reset}</button>
          {#if exportHref}
            <a href={exportHref} download="" class={buttonVariants({ variant: "ghost" })}><Icon name="download" />{l.export}</a>
          {/if}
          {#if saved}
            <span role="status" class="text-chart-2 inline-flex items-center gap-1 text-sm"><Icon name="check" />{l.saved}</span>
          {/if}
          {#if error}
            <span role="alert" class="text-destructive text-sm">{error}</span>
          {/if}
        </div>
      </form>
      <aside class="flex flex-col gap-3 lg:sticky lg:top-20 lg:self-start" aria-label={l.preview}>
        <h3 class="text-sm font-semibold">{l.preview}</h3>
        <ThemePreview draft={draft} side="light" base={base.light} labels={l} />
        <ThemePreview draft={draft} side="dark" base={base.dark} labels={l} />
        {#if site && site.pages.length > 0}
          <section class="flex flex-col gap-2" aria-label={l.sitePreview}>
            <h3 class="text-sm font-semibold">{l.sitePreview}</h3>
            <p class="text-muted-foreground text-xs">{l.sitePreviewLead}</p>
            <div class="flex flex-wrap gap-1">
              {#each site.pages as pg (pg.path)}
                <button type="button" class={buttonVariants({ variant: siteSrc && sitePath === pg.path ? "secondary" : "outline", size: "sm" })} @click={showSite(pg.path)} :busy>{pg.label}</button>
              {/each}
            </div>
            {#if siteError}
              <p role="alert" class="text-destructive text-xs">{siteError}</p>
            {/if}
            {#if siteSrc}
              <a href={siteSrc} target="_blank" rel="noopener" class={buttonVariants({}) + " w-fit gap-2"}><Icon name="eye" />{l.siteOpen}</a>
            {/if}
          </section>
        {/if}
      </aside>
    </div>
  }
}

export interface TranslationKey {
  key: string;
  base: string;
  current: string;
  overridden: boolean;
  inherited: boolean;
  plugin: string | null;
  args: string[];
}

export interface LocaleChoice {
  id: string;
  label: string;
  href: string;
  dir?: "ltr" | "rtl";
}

export interface TranslationLabels {
  title: string;
  locale: string;
  search: string;
  onlyChanged: string;
  key: string;
  base: string;
  message: string;
  save: string;
  reset: string;
  overridden: string;
  inherited: string;
  plugin: string;
  args: string;
  empty: string;
  saved: string;
}

export const DEFAULT_TRANSLATION_LABELS: TranslationLabels = {
  title: "Translations",
  locale: "Language",
  search: "Search keys or text",
  onlyChanged: "Only changed",
  key: "Key",
  base: "Default",
  message: "Your text",
  save: "Save",
  reset: "Reset",
  overridden: "Changed",
  inherited: "From parent",
  plugin: "Plugin",
  args: "Placeholders",
  empty: "No keys match.",
  saved: "Saved",
};

export type ErrorMap = Record<string, string>;

export function filterKeys(rows: readonly TranslationKey[], q: string, changed: boolean): TranslationKey[] {
  const needle = q.trim().toLowerCase();
  return rows.filter((r) => (!changed || r.overridden || r.inherited) && (!needle || r.key.toLowerCase().includes(needle) || r.current.toLowerCase().includes(needle) || r.base.toLowerCase().includes(needle)));
}

component TranslationEditor(rows: () => TranslationKey[], locale: string, locales: LocaleChoice[], onSave: (key: string, message: string | null) => Promise<string | null> | string | null, pageSize?: number, labels?: TranslationLabels, ...attrs: Attrs) {
  derived l = labels ?? DEFAULT_TRANSLATION_LABELS
  signal q = ""
  signal changed = false
  signal limit = pageSize ?? 50
  signal errors = {} as ErrorMap
  signal done = ""
  derived all = filterKeys(rows(), q, changed)
  derived shown = all.slice(0, limit)
  derived dir = locales.find((x) => x.id === locale)?.dir ?? "ltr"
  function search(e: WeftEvent) {
    q = String(e.value ?? "").slice(0, 100)
    limit = pageSize ?? 50
  }
  function toggleChanged(e: WeftEvent) {
    changed = e.value === "on" || e.value === "true" || !changed
  }
  function more() {
    limit = limit + (pageSize ?? 50)
  }
  function save(key: string, e: WeftEvent) {
    const message = String(e.form?.message ?? "")
    return Promise.resolve(onSave(key, message)).then((err) => {
      const next = { ...errors }
      if (err) next[key] = err
      else delete next[key]
      errors = next
      done = err ? "" : key
    })
  }
  function reset(key: string) {
    return Promise.resolve(onSave(key, null)).then((err) => {
      const next = { ...errors }
      if (err) next[key] = err
      else delete next[key]
      errors = next
      done = err ? "" : key
    })
  }
  view {
    <section aria-label={l.title} data-slot="translation-editor" class={cn("flex flex-col gap-4", attrs.class)} {...attrs}>
      <div class="flex flex-wrap items-center gap-2">
        <nav aria-label={l.locale} class="bg-muted inline-flex flex-wrap rounded-md p-0.5">
          {#each locales as lc (lc.id)}
            <a href={lc.href} aria-current={lc.id === locale ? "true" : undefined} class={cn("rounded-md px-2.5 py-1 text-xs font-medium", lc.id === locale ? "bg-card text-foreground shadow-xs" : "text-muted-foreground hover:text-foreground")}>{lc.label}</a>
          {/each}
        </nav>
        <input type="search" value={q} placeholder={l.search} aria-label={l.search} class={cn(inputClass, "max-w-xs flex-1")} @input.debounce(250ms)={search} />
        <label class="flex items-center gap-2 text-sm">
          <input type="checkbox" checked={changed} class="accent-primary size-4" @change={toggleChanged} />
          {l.onlyChanged}
        </label>
        <span class="text-muted-foreground ms-auto text-xs tabular-nums">{String(all.length)}</span>
      </div>
      {#if shown.length === 0}
        <p class="bg-card/60 text-muted-foreground rounded-2xl border border-dashed px-6 py-10 text-center text-sm leading-6">{l.empty}</p>
      {:else}
        <ul class="flex flex-col gap-2">
          {#each shown as r (r.key)}
            <li class="bg-card rounded-2xl border p-4">
              <form class="grid gap-3 md:grid-cols-2" @submit.prevent={save(r.key)}>
                <div class="flex min-w-0 flex-col gap-1.5">
                  <div class="flex flex-wrap items-center gap-1.5">
                    <code class="truncate font-mono text-xs font-medium">{r.key}</code>
                    {#if r.overridden}
                      <span class="bg-primary/10 text-primary rounded-full px-2 py-0.5 text-[10px] font-medium">{l.overridden}</span>
                    {/if}
                    {#if r.inherited && !r.overridden}
                      <span class="bg-muted text-muted-foreground rounded-full px-2 py-0.5 text-[10px] font-medium">{l.inherited}</span>
                    {/if}
                    {#if r.plugin}
                      <span class="bg-chart-4/10 text-chart-4 rounded-full px-2 py-0.5 text-[10px] font-medium">{l.plugin}: {r.plugin}</span>
                    {/if}
                  </div>
                  <p class="text-muted-foreground text-sm break-words whitespace-pre-wrap">{r.base}</p>
                  {#if r.args.length}
                    <p class="text-muted-foreground flex flex-wrap items-center gap-1 text-xs">
                      {l.args}:
                      {#each r.args as a (a)}
                        <code class="bg-muted rounded px-1 font-mono">{"{" + a + "}"}</code>
                      {/each}
                    </p>
                  {/if}
                </div>
                <div class="flex flex-col gap-2">
                  <textarea name="message" rows="2" dir={dir} lang={locale} aria-label={`${l.message}: ${r.key}`} aria-invalid={errors[r.key] ? "true" : undefined} class={cn(textareaClass, "min-h-16 text-sm")}>{r.current}</textarea>
                  <div class="flex items-center gap-2">
                    <button type="submit" class={buttonVariants({ size: "sm" })} :busy>{l.save}</button>
                    {#if r.overridden}
                      <button type="button" class={buttonVariants({ variant: "ghost", size: "sm" })} @click={reset(r.key)} :busy>{l.reset}</button>
                    {/if}
                    {#if done === r.key}
                      <span role="status" class="text-chart-2 inline-flex items-center gap-1 text-xs"><Icon name="check" class="size-3" />{l.saved}</span>
                    {/if}
                  </div>
                  {#if errors[r.key]}
                    <p role="alert" class="text-destructive text-xs">{errors[r.key]}</p>
                  {/if}
                </div>
              </form>
            </li>
          {/each}
        </ul>
        {#if shown.length < all.length}
          <button type="button" class={cn(buttonVariants({ variant: "outline", size: "sm" }), "self-center")} @click={more}>{`${shown.length} / ${all.length}`}</button>
        {/if}
      {/if}
    </section>
  }
}

export interface NavDraftItem {
  id: string;
  title: string;
  href: string;
  icon: string | null;
  hidden: boolean;
  pinned: boolean;
  custom: boolean;
  newTab: boolean;
  locked?: boolean;
}

export interface NavLabels {
  title: string;
  moveUp: string;
  moveDown: string;
  hide: string;
  show: string;
  pin: string;
  unpin: string;
  rename: string;
  icon: string;
  remove: string;
  addLink: string;
  linkTitle: string;
  linkUrl: string;
  newTab: string;
  add: string;
  save: string;
  reset: string;
  saved: string;
  invalidUrl: string;
}

export const DEFAULT_NAV_LABELS: NavLabels = {
  title: "Navigation",
  moveUp: "Move up",
  moveDown: "Move down",
  hide: "Hide",
  show: "Show",
  pin: "Pin",
  unpin: "Unpin",
  rename: "Label",
  icon: "Icon",
  remove: "Remove",
  addLink: "Add a link",
  linkTitle: "Title",
  linkUrl: "URL",
  newTab: "Open in new tab",
  add: "Add",
  save: "Save",
  reset: "Reset",
  saved: "Saved",
  invalidUrl: "Use an https:// address or a path starting with /",
};

export function moveItem<T>(list: readonly T[], from: number, to: number): T[] {
  if (from < 0 || from >= list.length || to < 0 || to >= list.length || from === to) return [...list];
  const next = [...list];
  const [it] = next.splice(from, 1);
  next.splice(to, 0, it!);
  return next;
}

export function safeLink(href: string): boolean {
  return /^\/(?!\/)[^\s]*$/.test(href) || /^https:\/\/[^\s/]+\.[^\s]+$/.test(href);
}

component NavEditor(items: NavDraftItem[], onSave: (items: NavDraftItem[]) => Promise<string | null> | string | null, onReset: () => Promise<NavDraftItem[]> | NavDraftItem[], allowCustom?: boolean, labels?: NavLabels, ...attrs: Attrs) {
  derived l = labels ?? DEFAULT_NAV_LABELS
  derived icons = Object.keys(ICONS)
  signal list = items
  signal error = ""
  signal saved = false
  function move(id: string, by: number) {
    const i = list.findIndex((x) => x.id === id)
    list = moveItem(list, i, i + by)
    saved = false
  }
  function patch(id: string, change: Partial<NavDraftItem>) {
    list = list.map((x) => (x.id === id ? { ...x, ...change } : x))
    saved = false
  }
  function toggleHidden(id: string) {
    const it = list.find((x) => x.id === id)
    if (it && !it.locked) patch(id, { hidden: !it.hidden })
  }
  function togglePin(id: string) {
    const it = list.find((x) => x.id === id)
    if (it) patch(id, { pinned: !it.pinned })
  }
  function rename(id: string, e: WeftEvent) {
    patch(id, { title: String(e.value ?? "").trim().slice(0, 60) })
  }
  function setIcon(id: string, e: WeftEvent) {
    const v = String(e.value ?? "")
    patch(id, { icon: v === "" ? null : v })
  }
  function remove(id: string) {
    list = list.filter((x) => x.id !== id || !x.custom)
    saved = false
  }
  function add(e: WeftEvent) {
    const title = String(e.form?.title ?? "").trim().slice(0, 60)
    const href = String(e.form?.href ?? "").trim().slice(0, 2048)
    if (!title || !safeLink(href)) {
      error = l.invalidUrl
      return
    }
    error = ""
    const id = `custom-${Date.now().toString(36)}`
    list = [...list, { id, title, href, icon: "link", hidden: false, pinned: false, custom: true, newTab: e.form?.newTab !== undefined && e.form?.newTab !== "" }]
    saved = false
  }
  function save() {
    return Promise.resolve(onSave(list)).then((err) => {
      error = err ?? ""
      saved = err === null
    })
  }
  function reset() {
    return Promise.resolve(onReset()).then((d) => {
      list = d
      saved = true
      error = ""
    })
  }
  view {
    <section aria-label={l.title} data-slot="nav-editor" class={cn("flex flex-col gap-4", attrs.class)} {...attrs}>
      <ol class="bg-card divide-y rounded-2xl border">
        {#each list as it, i (it.id)}
          <li data-hidden={it.hidden ? "true" : "false"} class="data-[hidden=true]:bg-muted/40 flex flex-wrap items-center gap-2 px-3 py-2">
            <div class="flex flex-col">
              <button type="button" class={cn(buttonVariants({ variant: "ghost", size: "icon" }), "size-6")} aria-label={`${l.moveUp}: ${it.title}`} disabled={i === 0} @click={move(it.id, -1)}><Icon name="chevron-down" class="size-3 rotate-180" /></button>
              <button type="button" class={cn(buttonVariants({ variant: "ghost", size: "icon" }), "size-6")} aria-label={`${l.moveDown}: ${it.title}`} disabled={i === list.length - 1} @click={move(it.id, 1)}><Icon name="chevron-down" class="size-3" /></button>
            </div>
            <Icon name={it.icon ?? "dot"} class={it.hidden ? "text-muted-foreground" : ""} />
            <input value={it.title} aria-label={`${l.rename}: ${it.id}`} maxlength="60" class={cn(inputClass, "h-8 min-w-32 flex-1", it.hidden ? "text-muted-foreground line-through" : "")} @change={rename(it.id)} />
            <select aria-label={`${l.icon}: ${it.title}`} class={cn(inputClass, "h-8 w-32")} @change={setIcon(it.id)}>
              <option value="">—</option>
              {#each icons as ic (ic)}
                <option value={ic} selected={it.icon === ic}>{ic}</option>
              {/each}
            </select>
            <code class="text-muted-foreground hidden max-w-48 truncate font-mono text-xs lg:inline">{it.href}</code>
            <button type="button" aria-pressed={it.pinned ? "true" : "false"} class={cn(buttonVariants({ variant: it.pinned ? "secondary" : "ghost", size: "sm" }))} @click={togglePin(it.id)}><Icon name="pin" />{it.pinned ? l.unpin : l.pin}</button>
            {#if !it.locked}
              <button type="button" aria-pressed={it.hidden ? "true" : "false"} class={buttonVariants({ variant: "ghost", size: "sm" })} @click={toggleHidden(it.id)}><Icon name="eye" />{it.hidden ? l.show : l.hide}</button>
            {/if}
            {#if it.custom}
              <button type="button" class={cn(buttonVariants({ variant: "ghost", size: "icon" }), "text-destructive")} aria-label={`${l.remove}: ${it.title}`} @click={remove(it.id)}><Icon name="trash" /></button>
            {/if}
          </li>
        {/each}
      </ol>
      {#if allowCustom !== false}
        <form class="bg-card grid gap-2 rounded-2xl border p-4 sm:grid-cols-[1fr_1.5fr_auto_auto] sm:items-end" @submit.prevent={add}>
          <span class="text-sm font-medium sm:col-span-4">{l.addLink}</span>
          <label class="flex flex-col gap-1 text-xs">
            <span class="text-muted-foreground">{l.linkTitle}</span>
            <input name="title" required maxlength="60" class={inputClass} />
          </label>
          <label class="flex flex-col gap-1 text-xs">
            <span class="text-muted-foreground">{l.linkUrl}</span>
            <input name="href" required placeholder="https://" class={cn(inputClass, "font-mono text-xs")} />
          </label>
          <label class="flex h-9 items-center gap-2 text-xs">
            <input type="checkbox" name="newTab" value="1" class="accent-primary size-4" />
            {l.newTab}
          </label>
          <button type="submit" class={buttonVariants({ variant: "outline" })}><Icon name="plus" />{l.add}</button>
        </form>
      {/if}
      <div class="flex flex-wrap items-center gap-2">
        <button type="button" class={buttonVariants({})} @click={save} :busy>{l.save}</button>
        <button type="button" class={buttonVariants({ variant: "outline" })} @click={reset} :busy>{l.reset}</button>
        {#if saved}
          <span role="status" class="text-chart-2 inline-flex items-center gap-1 text-sm"><Icon name="check" />{l.saved}</span>
        {/if}
        {#if error}
          <span role="alert" class="text-destructive text-sm">{error}</span>
        {/if}
      </div>
    </section>
  }
}

export interface LayoutCell {
  i: string;
  widget: string;
  x: number;
  y: number;
  w: number;
  h: number;
  settings?: Record<string, unknown>;
}

export interface WidgetChoice {
  id: string;
  title: string;
  description?: string;
  minW?: number;
  maxW?: number;
  minH?: number;
  maxH?: number;
  defaultW?: number;
  defaultH?: number;
}

export interface LayoutLabels {
  title: string;
  palette: string;
  add: string;
  remove: string;
  moveLeft: string;
  moveRight: string;
  moveUp: string;
  moveDown: string;
  wider: string;
  narrower: string;
  taller: string;
  shorter: string;
  drag: string;
  save: string;
  reset: string;
  saved: string;
  scope: string;
}

export const DEFAULT_LAYOUT_LABELS: LayoutLabels = {
  title: "Dashboard layout",
  palette: "Widgets",
  add: "Add",
  remove: "Remove",
  moveLeft: "Move left",
  moveRight: "Move right",
  moveUp: "Move up",
  moveDown: "Move down",
  wider: "Wider",
  narrower: "Narrower",
  taller: "Taller",
  shorter: "Shorter",
  drag: "Drag to reorder",
  save: "Save layout",
  reset: "Reset",
  saved: "Saved",
  scope: "Applies to",
};

export function packLayout(cells: readonly LayoutCell[], columns: number): LayoutCell[] {
  const sorted = [...cells].sort((a, b) => a.y - b.y || a.x - b.x);
  const heights = new Array<number>(columns).fill(0);
  const out: LayoutCell[] = [];
  for (const c of sorted) {
    const w = Math.max(1, Math.min(c.w, columns));
    let bestX = Math.min(Math.max(0, c.x), columns - w);
    let bestY = Infinity;
    for (let x = 0; x <= columns - w; x++) {
      const y = Math.max(...heights.slice(x, x + w));
      if (y < bestY || (y === bestY && Math.abs(x - c.x) < Math.abs(bestX - c.x))) {
        bestY = y;
        bestX = x;
      }
    }
    const y = Math.max(...heights.slice(bestX, bestX + w));
    for (let x = bestX; x < bestX + w; x++) heights[x] = y + c.h;
    out.push({ ...c, x: bestX, y, w });
  }
  return out;
}

export function reorderCells(cells: readonly LayoutCell[], from: string, to: string, columns: number): LayoutCell[] {
  const order = [...cells].sort((a, b) => a.y - b.y || a.x - b.x);
  const a = order.findIndex((c) => c.i === from);
  const b = order.findIndex((c) => c.i === to);
  if (a < 0 || b < 0) return [...cells];
  const moved = moveItem(order, a, b);
  let y = 0;
  return packLayout(moved.map((c) => ({ ...c, y: y++ * 1000, x: c.x })), columns);
}

component LayoutEditor(cells: LayoutCell[], widgets: WidgetChoice[], columns: number, onSave: (cells: LayoutCell[]) => Promise<string | null> | string | null, onReset: () => Promise<LayoutCell[]> | LayoutCell[], scopes?: { id: string; label: string; href: string; active: boolean }[], labels?: LayoutLabels, preview?: (cell: LayoutCell) => string, ...attrs: Attrs) {
  derived l = labels ?? DEFAULT_LAYOUT_LABELS
  signal list = packLayout(cells, columns)
  signal error = ""
  signal saved = false
  derived ordered = [...list].sort((a, b) => a.y - b.y || a.x - b.x)
  function spec(id: string): WidgetChoice | undefined {
    return widgets.find((w) => w.id === id)
  }
  function commit(next: LayoutCell[]) {
    list = packLayout(next, columns)
    saved = false
  }
  function nudge(id: string, dx: number, dy: number) {
    commit(list.map((c) => (c.i === id ? { ...c, x: Math.max(0, Math.min(columns - c.w, c.x + dx)), y: Math.max(0, c.y + dy * 2 - (dy < 0 ? 1 : 0)) } : c)))
  }
  function resize(id: string, dw: number, dh: number) {
    commit(list.map((c) => {
      if (c.i !== id) return c
      const s = spec(c.widget)
      const w = Math.max(s?.minW ?? 1, Math.min(s?.maxW ?? columns, columns, c.w + dw))
      const h = Math.max(s?.minH ?? 1, Math.min(s?.maxH ?? 12, c.h + dh))
      return { ...c, w, h }
    }))
  }
  function remove(id: string) {
    commit(list.filter((c) => c.i !== id))
  }
  function add(widget: string) {
    const s = spec(widget)
    if (!s) return
    const bottom = list.reduce((m, c) => Math.max(m, c.y + c.h), 0)
    commit([...list, { i: `${widget}-${Date.now().toString(36)}`, widget, x: 0, y: bottom, w: Math.min(columns, s.defaultW ?? s.minW ?? 1), h: s.defaultH ?? s.minH ?? 2 }])
  }
  function dropped(e: WeftEvent) {
    const [from, to] = String(e.value ?? "").split(">")
    if (from && to && from !== to) commit(reorderCells(list, from, to, columns))
  }
  function save() {
    return Promise.resolve(onSave(list)).then((err) => {
      error = err ?? ""
      saved = err === null
    })
  }
  function reset() {
    return Promise.resolve(onReset()).then((d) => {
      list = packLayout(d, columns)
      saved = true
      error = ""
    })
  }
  client function dnd(el: HTMLElement) {
    const sink = el.querySelector<HTMLInputElement>("input[data-drop-sink]")
    let dragging = ""
    const start = (e: DragEvent) => {
      const cell = (e.target as Element | null)?.closest<HTMLElement>("[data-cell]")
      if (!cell) return
      dragging = cell.dataset.cell ?? ""
      e.dataTransfer?.setData("text/plain", dragging)
      if (e.dataTransfer) e.dataTransfer.effectAllowed = "move"
      cell.dataset.dragging = "true"
    }
    const over = (e: DragEvent) => {
      if (!dragging) return
      const cell = (e.target as Element | null)?.closest<HTMLElement>("[data-cell]")
      if (cell) {
        e.preventDefault()
        el.querySelectorAll<HTMLElement>("[data-drop-target]").forEach((n) => delete n.dataset.dropTarget)
        cell.dataset.dropTarget = "true"
      }
    }
    const end = () => {
      el.querySelectorAll<HTMLElement>("[data-dragging],[data-drop-target]").forEach((n) => {
        delete n.dataset.dragging
        delete n.dataset.dropTarget
      })
      dragging = ""
    }
    const drop = (e: DragEvent) => {
      const cell = (e.target as Element | null)?.closest<HTMLElement>("[data-cell]")
      if (!cell || !dragging || !sink) return
      e.preventDefault()
      sink.value = `${dragging}>${cell.dataset.cell ?? ""}`
      sink.dispatchEvent(new Event("change", { bubbles: true }))
      end()
    }
    el.addEventListener("dragstart", start)
    el.addEventListener("dragover", over)
    el.addEventListener("drop", drop)
    el.addEventListener("dragend", end)
    return () => {
      el.removeEventListener("dragstart", start)
      el.removeEventListener("dragover", over)
      el.removeEventListener("drop", drop)
      el.removeEventListener("dragend", end)
    }
  }
  view {
    <section aria-label={l.title} data-slot="layout-editor" class={cn("grid gap-6 xl:grid-cols-[minmax(0,1fr)_16rem]", attrs.class)} {...attrs}>
      <div class="flex flex-col gap-4">
        {#if scopes && scopes.length}
          <nav aria-label={l.scope} class="bg-muted inline-flex self-start rounded-md p-0.5">
            {#each scopes as s (s.id)}
              <a href={s.href} aria-current={s.active ? "true" : undefined} class={cn("rounded-md px-2.5 py-1 text-xs font-medium", s.active ? "bg-card text-foreground shadow-xs" : "text-muted-foreground hover:text-foreground")}>{s.label}</a>
            {/each}
          </nav>
        {/if}
        <div use:dnd style={`--cols:${columns}`} class="grid auto-rows-[4rem] grid-cols-1 gap-3 md:grid-cols-[repeat(var(--cols),minmax(0,1fr))]">
          <input type="hidden" data-drop-sink="" @change={dropped} />
          {#each ordered as c (c.i)}
            <article data-cell={c.i} draggable="true" aria-roledescription={l.drag} aria-label={spec(c.widget)?.title ?? c.widget} style={`grid-column:${c.x + 1} / span ${c.w};grid-row:${c.y + 1} / span ${c.h}`} class="bg-card data-[dragging=true]:opacity-50 data-[drop-target=true]:ring-primary group/cell flex flex-col overflow-hidden rounded-2xl border max-md:!col-auto max-md:!row-auto data-[drop-target=true]:ring-2">
              <header class="bg-muted/40 flex items-center gap-1 border-b px-2 py-1">
                <span class="text-muted-foreground cursor-grab" aria-hidden="true"><Icon name="grip" /></span>
                <span class="flex-1 truncate text-xs font-medium">{spec(c.widget)?.title ?? c.widget}</span>
                <span class="text-muted-foreground font-mono text-[10px] tabular-nums">{c.w}×{c.h}</span>
                <button type="button" class={cn(buttonVariants({ variant: "ghost", size: "icon" }), "text-destructive size-6")} aria-label={l.remove} @click={remove(c.i)}><Icon name="x" class="size-3" /></button>
              </header>
              <div class="text-muted-foreground flex flex-1 items-center justify-center p-2 text-center text-xs">{preview ? preview(c) : (spec(c.widget)?.description ?? "")}</div>
              <footer class="flex flex-wrap items-center justify-center gap-0.5 border-t p-1 opacity-70 group-focus-within/cell:opacity-100 group-hover/cell:opacity-100">
                <button type="button" class={cn(buttonVariants({ variant: "ghost", size: "icon" }), "size-6")} aria-label={l.moveLeft} @click={nudge(c.i, -1, 0)}><Icon name="chevron-right" class="size-3 rotate-180" /></button>
                <button type="button" class={cn(buttonVariants({ variant: "ghost", size: "icon" }), "size-6")} aria-label={l.moveUp} @click={nudge(c.i, 0, -1)}><Icon name="chevron-down" class="size-3 rotate-180" /></button>
                <button type="button" class={cn(buttonVariants({ variant: "ghost", size: "icon" }), "size-6")} aria-label={l.moveDown} @click={nudge(c.i, 0, 1)}><Icon name="chevron-down" class="size-3" /></button>
                <button type="button" class={cn(buttonVariants({ variant: "ghost", size: "icon" }), "size-6")} aria-label={l.moveRight} @click={nudge(c.i, 1, 0)}><Icon name="chevron-right" class="size-3" /></button>
                <span class="bg-border mx-1 h-4 w-px" aria-hidden="true"></span>
                <button type="button" class={cn(buttonVariants({ variant: "ghost", size: "sm" }), "h-6 px-1.5 text-xs")} aria-label={l.narrower} @click={resize(c.i, -1, 0)}>−W</button>
                <button type="button" class={cn(buttonVariants({ variant: "ghost", size: "sm" }), "h-6 px-1.5 text-xs")} aria-label={l.wider} @click={resize(c.i, 1, 0)}>+W</button>
                <button type="button" class={cn(buttonVariants({ variant: "ghost", size: "sm" }), "h-6 px-1.5 text-xs")} aria-label={l.shorter} @click={resize(c.i, 0, -1)}>−H</button>
                <button type="button" class={cn(buttonVariants({ variant: "ghost", size: "sm" }), "h-6 px-1.5 text-xs")} aria-label={l.taller} @click={resize(c.i, 0, 1)}>+H</button>
              </footer>
            </article>
          {/each}
        </div>
        <div class="flex flex-wrap items-center gap-2">
          <button type="button" class={buttonVariants({})} @click={save} :busy>{l.save}</button>
          <button type="button" class={buttonVariants({ variant: "outline" })} @click={reset} :busy>{l.reset}</button>
          {#if saved}
            <span role="status" class="text-chart-2 inline-flex items-center gap-1 text-sm"><Icon name="check" />{l.saved}</span>
          {/if}
          {#if error}
            <span role="alert" class="text-destructive text-sm">{error}</span>
          {/if}
        </div>
      </div>
      <aside aria-label={l.palette} class="flex flex-col gap-2">
        <h3 class="text-sm font-semibold">{l.palette}</h3>
        <ul class="flex flex-col gap-2">
          {#each widgets as w (w.id)}
            <li class="bg-card flex items-start gap-2 rounded-xl border p-3">
              <div class="flex min-w-0 flex-1 flex-col">
                <span class="truncate text-sm font-medium">{w.title}</span>
                {#if w.description}
                  <span class="text-muted-foreground line-clamp-2 text-xs">{w.description}</span>
                {/if}
              </div>
              <button type="button" class={buttonVariants({ variant: "outline", size: "sm" })} aria-label={`${l.add}: ${w.title}`} @click={add(w.id)}><Icon name="plus" /></button>
            </li>
          {/each}
        </ul>
      </aside>
    </section>
  }
}
